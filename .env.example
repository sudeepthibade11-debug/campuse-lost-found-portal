# ─── FindBack Environment Configuration ─────────────────────────────────────
# Copy this file to server/.env and fill in your values.
# NEVER commit .env to source control.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/findback_dev
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/findback_dev
MONGO_URI=mongodb://localhost:27017/findback_dev

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# ─── Frontend URL ────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads/items
MAX_FILE_SIZE_MB=5

# ─── Email (optional — in-app fallback used if not configured) ───────────────
# For local dev use Ethereal: https://ethereal.email/create
# For production use Resend, Mailgun, SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FindBack <noreply@findback.local>

# ─── Push Notifications (optional) ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@findback.local

# ─── Reminder Intervals ──────────────────────────────────────────────────────
# In minutes. Use short values (e.g. 1) for development testing.
REMINDER_FIRST_MINUTES=1440
REMINDER_SECOND_MINUTES=4320
